# Shared settings for development
APP_ENV=development
APP_LOG_LEVEL=INFO

# Local backend settings
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8001

# Desktop local API settings
TAURI_API_BASE_URL=http://127.0.0.1:8001

# Optional cloud providers placeholders
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Search providers
TAVILY_API_KEY=
BRAVE_API_KEY=

# Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Privacy and diagnostics
DIAGNOSTICS_ENABLED=false
TELEMETRY_ENABLED=false
