# Copy to .env in the repository root. Read by docker compose and by the backend.
# Every backend setting uses the ANVESHA_ prefix (see backend/src/anvesha/config.py).

# --- docker compose ---
POSTGRES_PASSWORD=anvesha
# Change these if the ports are already taken on your machine.
POSTGRES_PORT=5432
API_PORT=8000
WEB_PORT=3000

# --- backend (when running it outside Docker with `uv run`) ---
ANVESHA_ENV=development
ANVESHA_DATABASE_URL=postgresql+asyncpg://anvesha:anvesha@localhost:5432/anvesha
# Comma-separated browser origins allowed to call the API directly. The web app doesn't
# need this (its server forwards requests), but other browser clients might.
ANVESHA_CORS_ORIGINS=http://localhost:3000

# --- sign-in (multi-user mode) ---
# "local" (default): single user, no sign-in. "jwt": people create accounts and sign in
# to the web app, share team workspaces by invitation, and the API checks every request.
ANVESHA_AUTH_MODE=local
# The web app's public address (sign-in, invitation links, and the token issuer the API
# expects). Use your real https URL when others reach it over a network.
ANVESHA_WEB_URL=http://localhost:3000
# Signs sessions and encrypts the web app's token signing keys. Required with jwt mode.
# Keep it stable: changing it signs everyone out and needs the auth.jwks table cleared.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Only people with an invitation can join (they still create their account first).
ANVESHA_AUTH_DISABLE_SIGNUP=false
# Optional "Continue with GitHub / Google" buttons (OAuth apps you register; the
# callback URL is <ANVESHA_WEB_URL>/api/auth/callback/github or .../google).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Rate limits on expensive requests. Empty: on with sign-in, off in single-user mode.
# ANVESHA_RATE_LIMITS_ENABLED=
# ANVESHA_RATE_LIMIT_RUNS_PER_HOUR=30           (per workspace)
# ANVESHA_RATE_LIMIT_CHAT_PER_HOUR=120          (per user)
# ANVESHA_RATE_LIMIT_CLARIFY_PER_HOUR=60        (per user)
# ANVESHA_RATE_LIMIT_TOOLS_PER_10_MINUTES=300   (searches, fetches, uploads, tool calls)
# When running the backend and web app outside Docker with jwt mode, also set:
# ANVESHA_AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
# ANVESHA_AUTH_ISSUER=http://localhost:3000
# BETTER_AUTH_URL=http://localhost:3000
# ANVESHA_AUTH_DATABASE_URL=postgresql://anvesha:anvesha@localhost:5432/anvesha

# --- secrets ---
# Master key that encrypts stored API keys. Leave empty to auto-generate one on first
# start (kept in the anvesha-secrets Docker volume, or backend/.anvesha/ when run with uv).
# To set your own: uv run python -m anvesha.crypto
ANVESHA_SECRET_KEY=

# --- optional server-wide model access ---
# Usually you add keys per workspace through the API. Keys here are a fallback for every
# workspace, which suits a personal self-hosted install.
ANVESHA_OPENAI_API_KEY=
ANVESHA_ANTHROPIC_API_KEY=
ANVESHA_GEMINI_API_KEY=
ANVESHA_OPENROUTER_API_KEY=
ANVESHA_GROQ_API_KEY=
ANVESHA_MISTRAL_API_KEY=
# Local models via Ollama. In Docker use http://host.docker.internal:11434/v1
ANVESHA_OLLAMA_BASE_URL=

# --- web search ---
# docker compose runs SearXNG (free, no key). When running the backend with `uv run`,
# point it at the published port instead:
# ANVESHA_SEARXNG_URL=http://localhost:8888
SEARXNG_SECRET=change-me-anvesha-searxng
# Optional: a contact URL or mailto: for this SearXNG instance. Enables Wikipedia and
# Wikidata results (Wikimedia's API policy requires one).
SEARXNG_CONTACT_URL=
# Optional paid search APIs (workspaces can also add their own keys through the API).
ANVESHA_TAVILY_API_KEY=
ANVESHA_BRAVE_API_KEY=
ANVESHA_EXA_API_KEY=
# searxng, tavily, brave or exa. Empty: a workspace's own key first, then the first configured.
ANVESHA_DEFAULT_SEARCH_PROVIDER=

# --- scholarly sources (free) ---
# A contact email unlocks faster "polite pool" access at OpenAlex, Crossref and PubMed.
ANVESHA_SCHOLAR_CONTACT_EMAIL=
ANVESHA_OPENALEX_API_KEY=
# Semantic Scholar is heavily rate-limited without a key: https://www.semanticscholar.org/product/api
ANVESHA_SEMANTIC_SCHOLAR_API_KEY=
ANVESHA_NCBI_API_KEY=

# --- fetching (defaults shown) ---
# ANVESHA_FETCH_MAX_BYTES=26214400
# ANVESHA_FETCH_RESPECT_ROBOTS_TXT=true
# Let fetches reach localhost and private networks. Keep false unless you need it.
# ANVESHA_FETCH_ALLOW_PRIVATE_NETWORKS=false

# --- research runs (defaults shown) ---
# Spending limit per run in USD (runs stop gracefully with a partial report). Requests
# may set their own limit up to the ceiling. Leave a value empty for no limit.
# ANVESHA_RUN_DEFAULT_MAX_COST_USD=2.00
# ANVESHA_RUN_MAX_COST_CEILING_USD=50.00
# Researcher agents working in parallel within one run, and runs per worker process.
# ANVESHA_RUN_MAX_PARALLEL_RESEARCHERS=4
# ANVESHA_WORKER_CONCURRENCY=4
# ANVESHA_RUN_TIMEOUT_MINUTES=90
# Attempts for runs that hit temporary provider failures.
# ANVESHA_RUN_MAX_ATTEMPTS=3

# --- project chat (Research Assistant; defaults shown) ---
# Spending limit for one chat reply in USD. Leave empty for no limit.
# ANVESHA_CHAT_MAX_COST_USD=0.25
# ANVESHA_CHAT_MAX_STEPS=8
# ANVESHA_CHAT_REPLY_TIMEOUT_SECONDS=240

# --- MCP server ---
# Serve research tools to MCP clients at /mcp (they need an access token:
# `python -m anvesha.access_tokens create`). Set to false to turn it off.
# ANVESHA_MCP_ENABLED=true
# OAuth sign-in for claude.ai / ChatGPT connectors. Set the address internet clients use
# to reach the public service (`docker compose --profile public up`; tunnel or proxy
# HTTPS to 127.0.0.1:8001 only). In single-user mode also set a long random secret,
# asked for when approving a new connection. With ANVESHA_AUTH_MODE=jwt people approve
# connections in the web app, signed in, and no secret is needed.
# ANVESHA_MCP_PUBLIC_URL=https://anvesha.example.org
# ANVESHA_MCP_APPROVAL_SECRET=
# MCP_PUBLIC_PORT=8001

# --- tracing (Langfuse / OpenTelemetry) ---
# Traces of every run: agent steps, model calls with tokens and cost, and tool calls.
# Both Langfuse keys turn it on. For self-hosted Langfuse, set the host too.
ANVESHA_LANGFUSE_PUBLIC_KEY=
ANVESHA_LANGFUSE_SECRET_KEY=
# ANVESHA_LANGFUSE_HOST=https://cloud.langfuse.com
# Any other OTLP/HTTP backend (Jaeger, Tempo, Honeycomb...), with optional headers.
# ANVESHA_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# ANVESHA_OTLP_HEADERS=x-api-key=...
# Attach prompts, model outputs and tool arguments to traces. They contain users'
# questions and fetched web content, so only enable it if the backend may hold that.
# ANVESHA_TRACE_CONTENT=false
# Share of runs to trace (0 to 1).
# ANVESHA_TRACE_SAMPLE_RATE=1.0

# --- evals (python -m anvesha.evals; see evals/README.md) ---
# Database for eval projects. Default: "anvesha_eval" on the server above.
# ANVESHA_EVAL_DATABASE_URL=

# --- web app (when running it outside Docker with `pnpm dev`) ---
# Where the web app's server forwards /api/v1 requests.
# ANVESHA_API_URL=http://127.0.0.1:8000
